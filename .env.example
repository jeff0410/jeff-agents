# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 git 에 올라가지 않는다(chmod 600 권장).
DASH_USER=
# 12자 이상
DASH_PASSWORD=

# 서버 주소 — 같은 PC 에서만 볼 땐 127.0.0.1, 리버스 프록시가 붙을 땐 0.0.0.0
HOST=127.0.0.1
PORT=4545

# HTTPS 서브도메인으로 열 때 1 (쿠키에 Secure 를 붙인다)
COOKIE_SECURE=0
# 리버스 프록시 뒤에서 실제 접속 IP(X-Real-IP)를 믿을 때 1
TRUST_PROXY=0

# OTP(2단계) 시크릿. 비워 두면 첫 로그인 때 QR 로 등록하고 .totp-secret(600)에 저장한다.
# 다시 등록하려면 .totp-secret 을 지우고 서버를 다시 켠다.
DASH_TOTP_SECRET=
# 개발 서버 미리보기 도메인. <이름>.<도메인> 으로 previews.json 의 개발 서버를 연다(로그인 쿠키도 하위 도메인에 공유).
PREVIEW_DOMAIN=
# 총괄 세션 폴더 이름(~/project/<이름>). 이 폴더에서 띄운 세션을 「총괄」로 표시하고, 새 세션 폴더 목록에 그 하위 폴더도 넣는다.
LEAD_DIR=
# 서브에이전트 별칭(type:화면 이름, 쉼표 구분). 예: web:웹,api:백엔드
AGENT_NICKNAMES=
# 읽기 전용으로 표시할 서브에이전트 type(쉼표 구분). 예: api
READONLY_AGENTS=
# 화면에 보이는 서버 이름(로고 옆·조직도 맨 위). 비우면 SERVER
SERVER_NAME=
